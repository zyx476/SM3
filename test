}

// -------------------------- 主函数入口 --------------------------
int main(int argc, char* argv[]) {
    // 初始化随机数种子（确保每次运行翻转位置不同）
    srand((unsigned int)time(NULL) ^ GetCurrentProcessId());

    // 1. 命令行工具模式
    if (argc == 3) {
        sm3_cli_tool(argc, argv);
        return 0;
    }

    // 2. 完整测试模式
    printf("========== SM3算法完整测试（随机雪崩+边界测试） ==========\n");
    // 2.1 标准用例验证
    verify_standard_cases();

    // 2.2 边界测试
    sm3_boundary_test();

    // 2.3 随机化雪崩效应测试（核心修改）
    sm3_avalanche_test();

    // 2.4 抗碰撞性测试
    sm3_collision_test();

    // 2.5 性能测试
    printf("\n=== 性能测试 ===\n");
    size_t test_sizes[] = { 128, 1024, 10 * 1024, 100 * 1024, 1024 * 1024, 10 * 1024 * 1024 };
    char size_names[6][20] = { "128B", "1K", "10K", "100K", "1M", "10M" };
    SM3_PERF_STATS stats;

    for (int i = 0; i < 6; i++) {
        sm3_perf_test(test_sizes[i], &stats);
        printf("输入%s：\n  平均耗时：%.2fms | 吞吐量：%.2fMB/s | 最大内存：%zuKB\n",
            size_names[i], stats.avg_time_ms, stats.throughput_mbs, stats.max_memory_kb);
    }

    printf("\n========== 所有测试完成 ==========\n");
    return 0;
}
