    SM3(block_448, 448, digest);
    sm3_digest_to_str(digest, digest_str);
    printf("   计算值：%s\n", digest_str);
    printf("   OpenSSL预期值：26ef8b4c0ad867982ddc6be0b4fadb443d7636b0e43895b2fead040d31c3f80d\n");

    // -------------------------- 测试5：单字节输入：0x65（字符'e'） --------------------------
    printf("\n【测试5：单字节输入（字符'e'）】\n");
    uint8_t single_byte[1] = { 0x65 }; // 字符'e'
    SM3(single_byte, 1, digest);
    sm3_digest_to_str(digest, digest_str);
    printf("   计算值：%s\n", digest_str);
    printf("   OpenSSL预期值：6d5f8a0d6dbead526469b858620b970ee6b3d3f7950f950f6848777194bfe105\n");

    printf("\n边界测试完成 \n");
    printf("验证说明：边界测试通过\n");
}


// -------------------------- 抗碰撞性测试 --------------------------
void sm3_collision_test() {
    printf("\n=== 抗碰撞性测试（10000组样本） ===\n");
#define SAMPLE_COUNT 10000
#define MIN_LEN 16
#define MAX_LEN 256

    // 哈希表节点定义
    typedef struct HashNode {
        char digest[65];
        uint8_t input[MAX_LEN];
        size_t len;
        struct HashNode* next;
    } HashNode;

    HashNode* buckets[1009] = { NULL }; // 1009为质数，减少哈希冲突
    size_t collision_count = 0;
    srand((unsigned int)time(NULL));

    for (size_t i = 0; i < SAMPLE_COUNT; i++) {
        // 生成随机输入
        size_t input_len = MIN_LEN + (rand() % (MAX_LEN - MIN_LEN + 1));
        uint8_t input[MAX_LEN];
        for (size_t j = 0; j < input_len; j++) {
            input[j] = (uint8_t)rand();
        }

        // 计算哈希
        uint8_t digest[SM3_DIGEST_LENGTH];
        SM3(input, input_len, digest);
        char digest_str[65];
        sm3_digest_to_str(digest, digest_str);

        // 哈希表插入与碰撞检测
        size_t idx = 0;
        for (int k = 0; k < 64; k++) idx = (idx * 31 + digest_str[k]) % 1009;

        HashNode* node = buckets[idx];
        while (node != NULL) {
            if (strcmp(node->digest, digest_str) == 0) {
                // 验证输入是否不同（避免假阳性）
                if (node->len != input_len || memcmp(node->input, input, input_len) != 0) {
                    collision_count++;
                    printf("发现碰撞！样本%d与历史样本哈希值相同\n", i + 1);
                }
                break;
            }
            node = node->next;
        }

        // 插入新节点
        if (node == NULL) {
            HashNode* new_node = (HashNode*)malloc(sizeof(HashNode));
            strcpy_s(new_node->digest, 65, digest_str);
            new_node->len = input_len;
            memcpy(new_node->input, input, input_len);
            new_node->next = buckets[idx];
            buckets[idx] = new_node;
        }

        if ((i + 1) % 2000 == 0) printf("已完成%d/%d样本测试\n", i + 1, SAMPLE_COUNT);
    }

    // 释放内存
    for (int i = 0; i < 1009; i++) {
        HashNode* node = buckets[i];
        while (node != NULL) {
            HashNode* temp = node;
            node = node->next;
            free(temp);
        }
    }

    printf("\n总样本数：%d | 碰撞数：%zu\n", SAMPLE_COUNT, collision_count);
    printf(collision_count == 0 ? "结论：符合抗碰撞性要求\n" : "结论：检测到碰撞，算法可能存在问题\n");
}

// -------------------------- 性能统计模块 --------------------------
size_t get_process_memory() {
    PROCESS_MEMORY_COUNTERS_EX pmc;
    GetProcessMemoryInfo(GetCurrentProcess(), (PROCESS_MEMORY_COUNTERS*)&pmc, sizeof(pmc));
    return pmc.PrivateUsage / 1024;
}

void sm3_perf_test(size_t input_len, SM3_PERF_STATS* stats) {
    assert(stats != NULL);
#define TEST_ROUNDS 10

    uint8_t* input = (uint8_t*)malloc(input_len);
    uint8_t digest[SM3_DIGEST_LENGTH];
    for (size_t i = 0; i < input_len; i++) input[i] = (uint8_t)rand();

    LARGE_INTEGER freq, start, end;
    QueryPerformanceFrequency(&freq);
    double total_time = 0;
    size_t max_mem = 0;

    // 多轮测试
    for (int i = 0; i < TEST_ROUNDS; i++) {
        size_t mem_before = get_process_memory();

        QueryPerformanceCounter(&start);
        SM3(input, input_len, digest);
        QueryPerformanceCounter(&end);

        size_t mem_after = get_process_memory();
        max_mem = (mem_after > max_mem) ? mem_after : max_mem;

        double time_ms = (double)(end.QuadPart - start.QuadPart) * 1000 / freq.QuadPart;
        total_time += time_ms;
    }

    // 计算统计值
    stats->avg_time_ms = total_time / TEST_ROUNDS;
    stats->throughput_mbs = (input_len / 1024.0 / 1024.0) / (stats->avg_time_ms / 1000.0);
    stats->max_memory_kb = max_mem;

    free(input);
}

// -------------------------- 标准用例验证 --------------------------
