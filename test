// -------------------------- SM3核心算法（修正后） --------------------------
#define SM3_DIGEST_LENGTH 32
#define SM3_BLOCK_SIZE 64

typedef struct {
    uint32_t state[8];          // 初始向量IV
    uint64_t totalLength;       // 消息总长度(bit)
    uint8_t buffer[SM3_BLOCK_SIZE]; // 消息缓冲区
    int bufferLength;           // 缓冲区字节数
} SM3_CTX;

// 轮常量（1-16轮用0x79CC4519，17-64轮用0x7A879D8A）
#define T(j)  (j < 16 ? 0x79CC4519 : 0x7A879D8A)

// 循环左移（32位无符号数，确保移位正确）
#define ROTL(X, n)  (((X) << (n)) | ((X) >> (32 - (n))))

// 布尔函数（严格区分16轮前后）
#define FF0(X, Y, Z)  ((X) ^ (Y) ^ (Z))
#define FF1(X, Y, Z)  (((X) & (Y)) | ((X) & (Z)) | ((Y) & (Z)))  // 三个与的或
#define GG0(X, Y, Z)  ((X) ^ (Y) ^ (Z))
#define GG1(X, Y, Z)  (((X) & (Y)) | (~(X) & (Z)))  // 注意~X的逻辑

// 置换函数（移位位数严格匹配标准）
#define P0(X)  ((X) ^ ROTL(X, 9) ^ ROTL(X, 17))   // 9位和17位
#define P1(X)  ((X) ^ ROTL(X, 15) ^ ROTL(X, 23))  // 15位和23位

// 初始化IV（严格匹配国密标准）
void SM3_Init(SM3_CTX* ctx) {
    ctx->state[0] = 0x7380166F;
    ctx->state[1] = 0x4914B2B9;
    ctx->state[2] = 0x172442D7;
    ctx->state[3] = 0xDA8A0600;
    ctx->state[4] = 0xA96F30BC;
    ctx->state[5] = 0x163138AA;
    ctx->state[6] = 0xE38DEE4D;
    ctx->state[7] = 0xB0FB0E4E;  // 标准IV值，不可修改
    ctx->totalLength = 0;
    ctx->bufferLength = 0;
}

// 压缩函数（核心修正：消息扩展和迭代逻辑）
static void SM3_Compress(SM3_CTX* ctx, const uint8_t block[SM3_BLOCK_SIZE]) {
    uint32_t W[68], W1[64];  // 消息扩展数组
    uint32_t A, B, C, D, E, F, G, H;  // 工作变量
    uint32_t SS1, SS2, TT1, TT2;
    int i;

    // 步骤1：消息扩展（修正W和W'生成逻辑）
    // W[0-15]：从输入块生成（大端序）
    for (i = 0; i < 16; i++) {
        W[i] = (block[4 * i] << 24) | (block[4 * i + 1] << 16) |
            (block[4 * i + 2] << 8) | block[4 * i + 3];
    }
    // W[16-67]：按标准公式生成（重点修正）
    for (i = 16; i < 68; i++) {
        W[i] = P1(W[i - 16] ^ W[i - 9] ^ ROTL(W[i - 3], 15)) ^
            ROTL(W[i - 13], 7) ^ W[i - 6];  // 正确的扩展公式
    }
    // W'[0-63]：W[i] ^ W[i+4]
    for (i = 0; i < 64; i++) {
        W1[i] = W[i] ^ W[i + 4];
    }

    // 步骤2：初始化工作变量
    A = ctx->state[0];
    B = ctx->state[1];
    C = ctx->state[2];
    D = ctx->state[3];
    E = ctx->state[4];
    F = ctx->state[5];
    G = ctx->state[6];
    H = ctx->state[7];

    // 步骤3：64轮迭代（修正工作变量更新顺序和临时变量计算）
    for (i = 0; i < 64; i++) {
        // 修正SS1计算：T(i)左移i位
        SS1 = ROTL(ROTL(A, 12) + E + ROTL(T(i), i), 7);
        SS2 = SS1 ^ ROTL(A, 12);
        // 修正布尔函数切换（i<16用FF0/GG0，i>=16用FF1/GG1）
        TT1 = (i < 16 ? FF0(A, B, C) : FF1(A, B, C)) + D + SS2 + W1[i];
        TT2 = (i < 16 ? GG0(E, F, G) : GG1(E, F, G)) + H + SS1 + W[i];

        // 严格按顺序更新工作变量（D→C→B→A→H→G→F→E）
        D = C;
        C = ROTL(B, 9);   // B左移9位（修正：避免写成其他位数）
        B = A;
        A = TT1;
        H = G;
        G = ROTL(F, 19);  // F左移19位（修正：避免写成其他位数）
        F = E;
        E = P0(TT2);      // 必须对TT2做P0置换（修正：不可遗漏）
    }

    // 步骤4：更新状态
    ctx->state[0] ^= A;
    ctx->state[1] ^= B;
    ctx->state[2] ^= C;
    ctx->state[3] ^= D;
    ctx->state[4] ^= E;
    ctx->state[5] ^= F;
    ctx->state[6] ^= G;
    ctx->state[7] ^= H;
}

// 更新函数（处理输入数据）
void SM3_Update(SM3_CTX* ctx, const uint8_t* data, size_t length) {
    size_t i;
    for (i = 0; i < length; i++) {
        ctx->buffer[ctx->bufferLength++] = data[i];
        if (ctx->bufferLength == SM3_BLOCK_SIZE) {
            SM3_Compress(ctx, ctx->buffer);
            ctx->totalLength += 8 * SM3_BLOCK_SIZE;  // 累计bit长度
            ctx->bufferLength = 0;
        }
    }
}

// 最终函数（修正填充逻辑）
void SM3_Final(uint8_t digest[SM3_DIGEST_LENGTH], SM3_CTX* ctx) {
    int i;
    uint64_t bitLength = ctx->totalLength + (uint64_t)ctx->bufferLength * 8;  // 总长度(bit)

    // 填充步骤（严格按国密标准）
    ctx->buffer[ctx->bufferLength++] = 0x80;  // 补1个"1"
    // 若剩余空间不足8字节（存储长度），先压缩
    if (ctx->bufferLength > SM3_BLOCK_SIZE - 8) {
        memset(ctx->buffer + ctx->bufferLength, 0, SM3_BLOCK_SIZE - ctx->bufferLength);
        SM3_Compress(ctx, ctx->buffer);
        ctx->bufferLength = 0;
    }
    // 补0至剩余8字节
    memset(ctx->buffer + ctx->bufferLength, 0, SM3_BLOCK_SIZE - 8 - ctx->bufferLength);
    // 存储长度（大端序：高位字节在前，修正移位方向）
    for (i = 0; i < 8; i++) {
        ctx->buffer[SM3_BLOCK_SIZE - 8 + i] = (uint8_t)(bitLength >> (8 * (7 - i)));
    }

    // 处理最后一个块
    SM3_Compress(ctx, ctx->buffer);

    // 输出哈希值（大端序，修正字节拆分）
    for (i = 0; i < 8; i++) {
        digest[4 * i] = (uint8_t)(ctx->state[i] >> 24);   // 最高位字节
        digest[4 * i + 1] = (uint8_t)(ctx->state[i] >> 16);
        digest[4 * i + 2] = (uint8_t)(ctx->state[i] >> 8);
        digest[4 * i + 3] = (uint8_t)(ctx->state[i]);      // 最低位字节
    }
}

// 便捷函数
void SM3(const uint8_t* data, size_t length, uint8_t digest[SM3_DIGEST_LENGTH]) {
    SM3_CTX ctx;
    SM3_Init(&ctx);
    SM3_Update(&ctx, data, length);
    SM3_Final(digest, &ctx);
}

// -------------------------- 雪崩效应测试（增强验证版） --------------------------
// 哈希值转字符串
void sm3_digest_to_str(const uint8_t digest[SM3_DIGEST_LENGTH], char* str) {
    for (int i = 0; i < SM3_DIGEST_LENGTH; i++) {
        sprintf_s(str + 2 * i, 3, "%02x", digest[i]);
    }
    str[2 * SM3_DIGEST_LENGTH] = '\0';
}

// 雪崩效应测试（添加比特翻转验证和差异统计日志）
void sm3_avalanche_test(const uint8_t* original_input, size_t input_len, int test_rounds) {
    if (original_input == NULL || input_len == 0 || test_rounds <= 0) {
        printf("雪崩效应测试参数错误！\n");
        return;
    }

    // 计算原始哈希值
    uint8_t original_digest[SM3_DIGEST_LENGTH];
    SM3(original_input, input_len, original_digest);
    char original_digest_str[2 * SM3_DIGEST_LENGTH + 1];
    sm3_digest_to_str(original_digest, original_digest_str);
    printf("=== 雪崩效应测试（%d轮） ===\n", test_rounds);
    printf("原始输入：%.*s（长度：%zu字节）\n", (int)input_len, original_input, input_len);
    printf("原始哈希值（H0）：%s\n", original_digest_str);

    // 复制输入用于修改
    uint8_t* modified_input = (uint8_t*)malloc(input_len * sizeof(uint8_t));
    if (modified_input == NULL) {
        printf("内存分配失败！\n");
        return;
    }
    memcpy(modified_input, original_input, input_len);

    uint8_t modified_digest[SM3_DIGEST_LENGTH];
    char modified_digest_str[2 * SM3_DIGEST_LENGTH + 1];
    int total_diff_bits = 0;

    for (int round = 0; round < test_rounds; round++) {
        // 随机选择1个比特翻转
        int byte_idx = rand() % input_len;    // 随机字节索引
        int bit_idx = rand() % 8;             // 随机比特索引（0-7）
        uint8_t original_byte = modified_input[byte_idx];
        // 翻转比特（修正：确保只翻转1个比特）
        modified_input[byte_idx] ^= (1 << (7 - bit_idx));  // 7-bit_idx确保高位对应bit0
        uint8_t modified_byte = modified_input[byte_idx];

        // 验证比特翻转是否正确（仅输出前3轮，避免冗余）
        if (round < 3) {
            printf("\n第%d轮：翻转验证\n", round + 1);
            printf("  字节索引：%d（原始值：0x%02x，修改后：0x%02x）\n",
                byte_idx, original_byte, modified_byte);
            printf("  原始二进制：");
            for (int b = 7; b >= 0; b--) printf("%d", (original_byte >> b) & 1);
            printf("\n  修改后二进制：");
            for (int b = 7; b >= 0; b--) printf("%d", (modified_byte >> b) & 1);
            printf("\n  差异比特位置：%d（0为最高位）\n", bit_idx);
        }

        // 计算修改后的哈希值
        SM3(modified_input, input_len, modified_digest);
        sm3_digest_to_str(modified_digest, modified_digest_str);

        // 统计差异比特数（添加详细日志）
        int diff_bits = 0;
        if (round < 3) printf("  哈希差异详情：\n");
        for (int i = 0; i < SM3_DIGEST_LENGTH; i++) {
            uint8_t xor_val = original_digest[i] ^ modified_digest[i];
            int byte_diff = 0;
            uint8_t temp = xor_val;
            while (temp) {
                byte_diff += (temp & 1);
                temp >>= 1;
            }
            diff_bits += byte_diff;
            if (round < 3) {
                printf("    哈希字节%d：原0x%02x，改0x%02x，差异比特数：%d\n",
                    i, original_digest[i], modified_digest[i], byte_diff);
            }
        }
        total_diff_bits += diff_bits;

        // 输出本轮结果
        printf("第%d轮：修改第%d字节第%d比特 → 哈希值（H1）：%s → 差异比特数：%d\n",
            round + 1, byte_idx + 1, bit_idx + 1, modified_digest_str, diff_bits);

        // 恢复输入（避免多轮叠加修改）
        modified_input[byte_idx] ^= (1 << (7 - bit_idx));
    }

    // 测试总结
    double avg_diff_bits = (double)total_diff_bits / test_rounds;
    printf("\n=== 雪崩效应测试总结 ===\n");
    printf("测试轮次：%d | 总差异比特数：%d | 平均差异比特数：%.2f\n",
        test_rounds, total_diff_bits, avg_diff_bits);
    printf("标准要求：平均差异≥128比特（50%）\n");
    printf(avg_diff_bits >= 128 ? "结论：符合雪崩效应要求！\n" : "结论：不符合要求！\n");

    free(modified_input);
}

// -------------------------- 标准用例验证（确保算法正确） --------------------------
void verify_standard_cases() {
    printf("===================== 标准用例验证 =====================\n");
    // 用例1：空字符串
    uint8_t digest1[SM3_DIGEST_LENGTH];
    SM3((const uint8_t*)"", 0, digest1);
    printf("空字符串哈希值: ");
    for (int i = 0; i < SM3_DIGEST_LENGTH; i++) printf("%02x", digest1[i]);
    printf("（预期：1ab21d8355cfa17f8e61194831e81a8f22bec8c728fefb747ed035eb5082aa2b）\n");

    // 用例2："abc"
    uint8_t digest2[SM3_DIGEST_LENGTH];
    SM3((const uint8_t*)"abc", 3, digest2);
    printf("\"abc\"哈希值:   ");
    for (int i = 0; i < SM3_DIGEST_LENGTH; i++) printf("%02x", digest2[i]);
    printf("（预期：66c7f0f462eeedd9d1f2d46bdc10e4e24d8167c48b2860e270cf1a4427c52fcf8）\n");

    // 用例3：32个"abcd"
    const char* testStr = "abcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcd";
    uint8_t digest3[SM3_DIGEST_LENGTH];
    SM3((const uint8_t*)testStr, strlen(testStr), digest3);
    printf("重复\"abcd\"哈希值: ");
    for (int i = 0; i < SM3_DIGEST_LENGTH; i++) printf("%02x", digest3[i]);
    printf("（预期：debe9ff92275b8a138604889c18e5a4d6fdb70e5387e5765293dcba39c0c5732）\n\n");
}
// -------------------------- 抗碰撞性测试模块 --------------------------
// 哈希表节点：存储哈希值与对应输入数据（用于碰撞溯源）
typedef struct HashNode {
    char digest_str[2 * SM3_DIGEST_LENGTH + 1];  // 64位16进制哈希字符串
    uint8_t* input_data;                         // 对应输入数据
    size_t input_len;                            // 输入数据长度
    struct HashNode* next;                       // 链表解决哈希冲突
} HashNode;

// 哈希表结构：优化碰撞检测效率（O(n)复杂度）
typedef struct {
    HashNode** buckets;  // 桶数组
    size_t bucket_count; // 桶数量（质数，减少冲突）
} HashTable;

// 初始化哈希表（桶数量=样本数*1.5，确保为质数）
HashTable* hashtable_init(size_t sample_count) {
    HashTable* table = (HashTable*)malloc(sizeof(HashTable));
    if (!table) return NULL;

    // 计算桶数量（样本数的1.5倍，转为质数）
    table->bucket_count = (size_t)(sample_count * 1.5);
    while (1) {
        int is_prime = 1;
        for (size_t i = 2; i * i <= table->bucket_count; i++) {
            if (table->bucket_count % i == 0) {
                is_prime = 0;
                break;
            }
        }
        if (is_prime) break;
        table->bucket_count++;
    }

    // 初始化桶数组（全部置空）
    table->buckets = (HashNode**)calloc(table->bucket_count, sizeof(HashNode*));
    if (!table->buckets) {
        free(table);
        return NULL;
    }
    return table;
}

// 哈希函数：将哈希字符串映射到桶索引（FNV算法，低冲突）
size_t hashtable_hash(const char* digest_str, size_t bucket_count) {
    uint64_t hash_val = 14695981039346656037ULL;  // FNV初始值
    for (int i = 0; i < 2 * SM3_DIGEST_LENGTH; i++) {
        hash_val ^= (uint64_t)digest_str[i];
        hash_val *= 1099511628211ULL;  // FNV质数乘数
    }
    return hash_val % bucket_count;
}

// 插入哈希表并检测碰撞（返回1=碰撞，0=成功，-1=内存错误）
int hashtable_insert(HashTable* table, const char* digest_str, const uint8_t* input_data, size_t input_len) {
    size_t bucket_idx = hashtable_hash(digest_str, table->bucket_count);
    HashNode* current = table->buckets[bucket_idx];

    // 检查当前桶是否存在相同哈希值（碰撞检测）
    while (current) {
        if (strcmp(current->digest_str, digest_str) == 0) {
            // 发现碰撞，打印详细信息
            printf("\n===== 检测到碰撞！ =====\n");
            printf("输入1：长度=%zu字节，哈希值=%s\n", current->input_len, current->digest_str);
            printf("输入1前16字节数据：");
            for (size_t i = 0; i < current->input_len && i < 16; i++) {
                printf("%02x ", current->input_data[i]);
            }
            printf("\n");

            printf("输入2：长度=%zu字节，哈希值=%s\n", input_len, digest_str);
            printf("输入2前16字节数据：");
            for (size_t i = 0; i < input_len && i < 16; i++) {
                printf("%02x ", input_data[i]);
            }
            printf("\n======================\n");
            return 1;
        }
        current = current->next;
    }

    // 无碰撞，插入新节点
    HashNode* new_node = (HashNode*)malloc(sizeof(HashNode));
    if (!new_node) return -1;
    strcpy_s(new_node->digest_str, sizeof(new_node->digest_str), digest_str);
    new_node->input_len = input_len;
    new_node->input_data = (uint8_t*)malloc(input_len);
    if (!new_node->input_data) {
        free(new_node);
        return -1;
    }
    memcpy(new_node->input_data, input_data, input_len);
    new_node->next = table->buckets[bucket_idx];  // 头插法（高效）
    table->buckets[bucket_idx] = new_node;
    return 0;
}

// 释放哈希表内存（避免内存泄漏）
void hashtable_free(HashTable* table) {
    if (!table) return;
    for (size_t i = 0; i < table->bucket_count; i++) {
        HashNode* current = table->buckets[i];
        while (current) {
            HashNode* temp = current;
            current = current->next;
            free(temp->input_data);
            free(temp);
        }
    }
    free(table->buckets);
    free(table);
}

// 抗碰撞性测试主函数（参数：样本数、输入长度范围）
void sm3_collision_test(size_t sample_count, size_t min_len, size_t max_len) {
    if (sample_count == 0 || min_len == 0 || max_len < min_len) {
        printf("\n抗碰撞性测试参数错误！样本数>0，长度范围需合法\n");
        return;
    }

    printf("\n=== 开始抗碰撞性测试 ===\n");
    printf("测试样本数：%zu\n", sample_count);
    printf("输入长度范围：%zu-%zu字节\n", min_len, max_len);
    time_t start_time = time(NULL);  // 先存储时间戳到变量（左值）
    printf("测试开始时间：%s", ctime(&start_time));  // 传变量地址（合法左值）

    // 初始化哈希表
    HashTable* table = hashtable_init(sample_count);
    if (!table) {
        printf("哈希表初始化失败，测试终止！\n");
        return;
    }

    // 预分配输入数据缓冲区（最大长度，避免频繁malloc）
    uint8_t* input_data = (uint8_t*)malloc(max_len);
    if (!input_data) {
        printf("输入缓冲区分配失败，测试终止！\n");
        hashtable_free(table);
        return;
    }

    // 测试变量初始化
    uint8_t digest[SM3_DIGEST_LENGTH];
    char digest_str[2 * SM3_DIGEST_LENGTH + 1];
    size_t collision_count = 0;
    srand((unsigned int)time(NULL) ^ GetCurrentProcessId());  // 随机种子（防重复）

    // 生成随机样本并检测碰撞
    for (size_t i = 0; i < sample_count; i++) {
        // 1. 生成随机长度的输入数据（0-255随机字节）
        size_t input_len = min_len + (rand() % (max_len - min_len + 1));
        for (size_t j = 0; j < input_len; j++) {
            input_data[j] = (uint8_t)rand();  // 每个字节完全随机
        }

        // 2. 计算SM3哈希值
        SM3(input_data, input_len, digest);
        sm3_digest_to_str(digest, digest_str);

        // 3. 插入哈希表并检测碰撞
        int ret = hashtable_insert(table, digest_str, input_data, input_len);
        if (ret == 1) {
            collision_count++;
            // 可选：发现碰撞后继续测试或停止（此处继续）
        }
        else if (ret == -1) {
            printf("内存不足，测试提前终止！\n");
            break;
        }

        // 4. 打印测试进度（每10000样本）
        if ((i + 1) % 10000 == 0) {
            printf("已完成%zu/%zu样本测试，累计碰撞数：%zu\n",
                i + 1, sample_count, collision_count);
        }
    }

    // 测试总结
    printf("\n=== 抗碰撞性测试总结 ===\n");
    printf("总测试样本数：%zu\n", sample_count);
    printf("发现碰撞数：%zu\n", collision_count);
    printf(collision_count == 0 ? "结论：未检测到碰撞，符合SM3抗碰撞性要求！\n" :
        "结论：检测到碰撞，算法实现可能存在问题！\n");

    // 释放资源
    free(input_data);
    hashtable_free(table);
}
