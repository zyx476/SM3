    char str1[65]; sm3_digest_to_str(digest1, str1);
    printf("1. 空字符串：\n   计算值：%s\n   预期值：1ab21d8355cfa17f8e61194831e81a8f22bec8c728fefb747ed035eb5082aa2b\n", str1);

    // 用例2："abc"
